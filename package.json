{
  "name": "mcp-memory-server",
  "version": "1.0.0",
  "description": "Self-hosted MCP memory server shared across AI coding tools, backed by SQLite FTS5",
  "license": "MIT",
  "author": "Leonardo Ciccone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unveroleone/memory-mcp.git"
  },
  "homepage": "https://github.com/unveroleone/memory-mcp#readme",
  "keywords": [
    "mcp",
